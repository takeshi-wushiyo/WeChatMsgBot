<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Camera usage -->
    <key>NSCameraUsageDescription</key>
    <string>需要使用相机拍摄照片以生成瘦身效果预览。</string>

    <!-- Photo library read access (PHPicker does NOT require this on iOS 14+,
         but kept here for completeness and Save-to-Photos write permission) -->
